CCHAIR_APP_NAME=CoChairAI
CCHAIR_DATABASE_URL=sqlite:///./data/cchair.db
CCHAIR_UI_STORAGE_SECRET=replace-with-a-long-random-secret-minimum-16-characters
CCHAIR_SCHEDULER_TIMEZONE=UTC
CCHAIR_REMINDER_SCAN_INTERVAL_MINUTES=15
CCHAIR_SMTP_HOST=
CCHAIR_SMTP_PORT=587
CCHAIR_SMTP_USERNAME=
CCHAIR_SMTP_PASSWORD=
CCHAIR_SMTP_USE_TLS=True
CCHAIR_SMTP_FROM_ADDRESS=
CCHAIR_FOUNDRY_PROJECT_ENDPOINT=https://foundry-mbg.services.ai.azure.com/api/projects/proj-default
CCHAIR_FOUNDRY_DATA_AGENT_NAME=DataAgent
CCHAIR_FOUNDRY_MINUTES_AGENT_NAME=MinutesAgent
CCHAIR_FOUNDRY_PRESENTATION_AGENT_NAME=PresentationAgent
CCHAIR_FOUNDRY_AGENT_VERSION=2

# Microsoft Entra sign-in. Use the tenant that owns your users and SharePoint site,
# which is not necessarily the tenant hosting Foundry.
CCHAIR_AUTH_ENABLED=false
CCHAIR_AUTH_TENANT_ID=
CCHAIR_AUTH_CLIENT_ID=
CCHAIR_AUTH_CLIENT_SECRET=
CCHAIR_AUTH_REDIRECT_PATH=/auth/callback

# Identity assumed only while CCHAIR_AUTH_ENABLED is false.
CCHAIR_DEV_USER_UPN=local.developer@example.com
CCHAIR_DEV_USER_NAME=Local Developer

# Comma-separated UPNs permitted to approve. Empty means any signed-in user may approve.
CCHAIR_APPROVER_UPNS=